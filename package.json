{
  "name": "kaist-bus-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/legacy-redirects.cjs",
    "dev": "vite",
    "update-data": "python scripts/kaist_scrape.py",
    "build": "vite build && node scripts/legacy-redirects.cjs --out dist",
    "deploy": "npm run build",
    "preview": "vite preview",
    "prebuild": "npm run update-data && npm test",
    "test": "python -m unittest discover -s tests -p \"test_*.py\" && node --test tests/*.test.js"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  }
}
